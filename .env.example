# Heroku config vars (no secrets here). Generate VAPID keys with: npm run genvapid
# Canonical https origin used for http->https redirects (required in production)
APP_ORIGIN=https://your-app.herokuapp.com
DATABASE_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: ALLOWED_PUSH_HOSTS=web.push.apple.com,fcm.googleapis.com
# Local dev only: INSECURE_COOKIES=1  PGSSL=0
# Journal analysis (disabled by default). Set these as Heroku config vars yourself; never commit or paste a key.
# AI_ENABLED=1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# FAMILY_TZ=America/Los_Angeles   # display only
